# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://myuser:mypassword@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database Name in Atlas
DB_NAME=upes_club_portal
